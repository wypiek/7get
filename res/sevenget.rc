#include <winver.h>

1 24 "sevenget.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "SevenGet contributors"
      VALUE "FileDescription", "SevenGet package manager"
      VALUE "FileVersion", "1.0.0"
      VALUE "InternalName", "sevenget"
      VALUE "LegalCopyright", "MIT License"
      VALUE "OriginalFilename", "sevenget.exe"
      VALUE "ProductName", "SevenGet"
      VALUE "ProductVersion", "1.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
